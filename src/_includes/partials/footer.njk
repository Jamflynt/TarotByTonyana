<footer id="footer">
	<div class="inner">
		<h2 class="major">Connect and Begin Your Journey</h2>
		<p>Ready to unlock your intuitive potential? Reach out today to schedule a session or ask questions. Tonyana is eager to guide you toward clarity and empowerment on your personal path.</p>
		{% include "partials/contact-form.njk" %}
		<ul class="contact">
			<li class="icon solid fa-envelope"><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
			<li class="icon brands fa-facebook-f"><a href="{{ site.social.facebook }}" target="_blank" rel="noopener noreferrer">{{ site.social.facebookDisplay }}<span class="visually-hidden"> (opens in new tab)</span></a></li>
			<li class="icon brands fa-instagram"><a href="{{ site.social.instagram }}" target="_blank" rel="noopener noreferrer">{{ site.social.instagramDisplay }}<span class="visually-hidden"> (opens in new tab)</span></a></li>
		</ul>
		<ul class="copyright">
			<li><svg class="footer-diamond" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="#F5F1E9" stroke-width="1.5"><polygon points="10,1 19,10 10,19 1,10" /></svg>&copy;{{ build.year }} {{ site.title }}. All rights reserved.</li>
			<li><a href="/accessibility.html">Accessibility</a></li>
			<li><a href="/privacy.html">Privacy</a></li>
		</ul>
	</div>
</footer>
