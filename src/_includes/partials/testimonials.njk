<section class="wrapper style1" aria-label="Client quotes">
	<div class="inner">
		<div class="testimonial-rotator">
			{%- for t in testimonials %}
			<blockquote>
				<p>"{{ t.excerpt }}"</p>
				<cite>— {{ t.name }}, {{ t.city }} {{ t.state }}</cite>
			</blockquote>
			{%- endfor %}
		</div>
		<p class="motion-control"><button type="button" class="motion-toggle">Pause animations</button></p>
	</div>
</section>
